# Cài: cp rag-guide.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now rag-guide
[Unit]
Description=Tro ly AI huong dan events.dav.edu.vn (guide_api.py, 127.0.0.1:50010)
After=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/task-cli/site/events-dav/rag_guide_svc
ExecStart=/var/www/html/task-cli/site/events-dav/rag_guide_svc/venv/bin/python guide_api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
